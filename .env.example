# ──────────────────────────────────────────────────────────────
# Telegram Bot
# ──────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ──────────────────────────────────────────────────────────────
# База даних (PostgreSQL)
# Railway підставляє DATABASE_URL автоматично!
# Локально: скопіюйте рядок підключення з Railway → PostgreSQL → Connect
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/railway

# ──────────────────────────────────────────────────────────────
# (Опційно) AI-інтеграція — заповніть якщо використовуєте
# ──────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
